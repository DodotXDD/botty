    "wordset_id": "5645bdae31",
    "meanings": [
      {
        "id": "6f50157c76",
        "def": "suffering from xenophobia, or the fear of outsiders",
        "example": "Those remarks make it pretty clear how xenophobic you are.",
        "speech_part": "adjective",
        "example_tl": "Ang mga pahayag na iyon ay malinaw na malinaw kung gaano ka ka -xenophobic."
      }
    ]
  },
  "xanthous": {
