[sub_resource type="GDScript" id="GDScript_0gp0h"]
script/source = "extends Node2D   # or whatever base type your hero/enemy node is

signal died
signal hurt

# -- Stats / data
var hp: int = 100
var attack_power: int = 20

# This is the AnimatedSprite2D node used for animations
@onready var sprite: AnimatedSprite2D = $AnimatedSprite2D

func take_damage(amount: int) -> void:
	hp -= amount
	if hp <= 0:
		hp = 0
		emit_signal(\"hurt\")  # optional — you can use if you like
		die()
	else:
		emit_signal(\"hurt\")

func die() -> void:
	emit_signal(\"died\")

# Helper methods to play animations
func play_attack_anim() -> void:
	sprite.play(\"attack\")

func play_hurt_anim() -> void:
	sprite.play(\"hurt\")

func play_death_anim() -> void:
	sprite.play(\"death\")

func play_idle_anim() -> void:
	sprite.play(\"idle\")
"

